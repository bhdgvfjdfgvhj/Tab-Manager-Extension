{
  "manifest_version": 3,
  "name": "Tab Manager",
  "version": "1.0",
  "description": "Organize, search, and save your browser tabs.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}



